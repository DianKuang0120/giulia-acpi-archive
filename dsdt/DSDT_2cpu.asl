/*
 * OnePlus giulia (Ace 5 / 13R) - SM8650 (Lanai) DSDT
 *
 * CPU COUNT DIAGNOSTIC: two processors, paired with an APIC that enables
 * CPU0 and CPU1 only.  Used to find the point where SMP bring-up dies.
 *
 * Kept in sync with ../../../Silicon/Qualcomm/Lanai/APIC.aml, which is
 * generated by apic_cpu_count.py N.
 *
 * Build:
 *   iasl -tc -p DSDT DSDT_2cpu.asl
 */
DefinitionBlock ("DSDT.aml", "DSDT", 2, "QCOMM ", "SM8650 ", 3)
{
    Scope (\_SB)
    {
        Device (CPU0)
        {
            Name (_HID, "ACPI0007")
            Name (_UID, 0)
            Method (_STA, 0, NotSerialized) { Return (0x0F) }
        }

        Device (CPU1)
        {
            Name (_HID, "ACPI0007")
            Name (_UID, 1)
            Method (_STA, 0, NotSerialized) { Return (0x0F) }
        }
    }
}
