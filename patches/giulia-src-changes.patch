diff --git a/Silicon/Qualcomm/LanaiPkg/LanaiPkg.dsc.inc b/Silicon/Qualcomm/LanaiPkg/LanaiPkg.dsc.inc
index d8e888e..7428524 100644
--- a/Silicon/Qualcomm/LanaiPkg/LanaiPkg.dsc.inc
+++ b/Silicon/Qualcomm/LanaiPkg/LanaiPkg.dsc.inc
@@ -17,7 +17,19 @@
   #
   # KEP
   #
-  HAS_ACTLR_EL1_UNIMPLEMENTED_ERRATA         = 1
+  # MUST stay 0 on SM8650.  The errata patch rewrites every "mrs x?, actlr_el1"
+  # in winload/kernel into "mov x?, #0".  ACTLR_EL1 bit 6 is the SMP bit for
+  # Cortex-A720/X4; forcing the read to 0 leaves the secondary cores running
+  # without SMP enabled, so the machine hangs about half a turn into the
+  # Windows boot animation as soon as more than one CPU is started.
+  # Single-core builds boot fine, which is what made this so hard to spot.
+  #
+  # SM8650 has no such errata: the newer platforms in this tree (Kaanapali /
+  # SM8750, Moorea, Napali, ...) all set this to 0, only the older Lahaina /
+  # Palawan (SM8635) family sets it to 1.  The value here was inherited from
+  # the SM8635 table set, like the MADT problems.
+  #
+  HAS_ACTLR_EL1_UNIMPLEMENTED_ERRATA         = 0
   HAS_AMCNTENSET0_EL0_UNIMPLEMENTED_ERRATA   = 1
   HAS_GIC_V3_WITHOUT_IRM_FLAG_SUPPORT_ERRATA = 1
   HAS_PSCI_MEMPROTECT_FAILING_ERRATA         = 0
diff --git a/Silicon/Silicium/SiliciumPkg/Library/FrameBufferSerialPortLib/FrameBufferSerialPortLib.c b/Silicon/Silicium/SiliciumPkg/Library/FrameBufferSerialPortLib/FrameBufferSerialPortLib.c
index d2844e0..9a7de70 100644
--- a/Silicon/Silicium/SiliciumPkg/Library/FrameBufferSerialPortLib/FrameBufferSerialPortLib.c
+++ b/Silicon/Silicium/SiliciumPkg/Library/FrameBufferSerialPortLib/FrameBufferSerialPortLib.c
@@ -7,6 +7,23 @@
 #include "FrameBuffer.h"
 #include "Font.h"
 
+//
+// File Log Buffer - mirrors the frame buffer debug output into a fixed
+// physical memory region so a later DXE driver (LogToFileDxe) can flush it
+// to a file on the ESP partition.  The region is the "Log_Buffer" memory map
+// entry (0xA7605000, 32 KiB), which is already reserved for UEFI log use.
+//
+// Layout:
+//   [0 .. 8)        UINT64 magic  ("FBLOG"  0x474F4C4246)
+//   [8 .. 16)       UINT64 length (bytes of log text)
+//   [16 .. SIZE)    log text (linear, stops when full)
+//
+#define LOG_BUFFER_BASE  0xA7605000ULL
+#define LOG_BUFFER_SIZE  0x8000ULL     // 32 KiB
+#define LOG_BUFFER_DATA  (LOG_BUFFER_BASE + 16)
+
+#define LOG_MAGIC  0x474F4C4246ULL     // "FBLOG" little-endian
+
 inline
 STATIC
 UINT8*
@@ -267,6 +284,29 @@ SerialPortWrite (
     WriteFrameBuffer (FbBase, FbLength, *Buffer++);
   }
 
+  // Mirror the debug message into the file-log buffer (shared via fixed PA).
+  {
+    volatile UINT64 *Magic  = (volatile UINT64 *)(UINTN)LOG_BUFFER_BASE;
+    volatile UINT64 *Length = (volatile UINT64 *)(UINTN)(LOG_BUFFER_BASE + 8);
+    UINT8           *Data   = (UINT8 *)(UINTN)LOG_BUFFER_DATA;
+    UINT64           Used   = *Length;
+
+    if (*Magic != LOG_MAGIC) {
+      *Magic  = LOG_MAGIC;
+      *Length = 0;
+      Used    = 0;
+    }
+
+    if (Used < (LOG_BUFFER_SIZE - 16)) {
+      UINTN CopyLen = NumberOfBytes;
+      if (CopyLen > ((LOG_BUFFER_SIZE - 16) - Used)) {
+        CopyLen = (UINTN)((LOG_BUFFER_SIZE - 16) - Used);
+      }
+      CopyMem (Data + Used, Buffer - NumberOfBytes, CopyLen);
+      *Length = Used + CopyLen;
+    }
+  }
+
   // Enable Interrupts
   if (InterruptState) {
     ArmEnableInterrupts ();
